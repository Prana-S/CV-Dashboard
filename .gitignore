# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.DS_Store

# Keep data and generated model outputs local. Empty folders stay in the repo
# so new contributors know where to put their files.
data/raw/**
!data/raw/.gitkeep
!data/raw/marine_life/
!data/raw/marine_life/.gitkeep
!data/raw/plastic/
!data/raw/plastic/.gitkeep

data/processed/**
!data/processed/.gitkeep

# Trained model artifacts are generated locally and stay out of Git, with one
# deliberate exception: the best checkpoint is committed as the Week 2 model
# deliverable (about 9 MB), so it can be downloaded without retraining.
models/
outputs/*
*.h5
*.pth
*.keras
# This negation must stay last so it overrides the *.keras rule above.
!outputs/best_model.keras

